  m_Name: DialogList
  m_EditorClassIdentifier: 
  FullDialogsList:
  - IDDialog: 0
    Message:
      english: Hey, Schoolboy! Granny's always hiding something from me. Help me
        figure out what it is, and I'll let you skip homework for a whole week!
      russian: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0421\u043A\u0443\u043B-\u0411\u043E\u0439!
        \u0413\u0440\u0435\u043D\u043D\u0438 \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
        \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043E\u0442 \u043C\u0435\u043D\u044F.
        \u041F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044C,
        \u0447\u0442\u043E \u0438\u043C\u0435\u043D\u043D\u043E, - \u0438 \u0442\u043E\u0433\u0434\u0430
        \u0440\u0430\u0437\u0440\u0435\u0448\u0443 \u0442\u0435\u0431\u0435 \u043D\u0435
        \u0434\u0435\u043B\u0430\u0442\u044C \u0434\u043E\u043C\u0430\u0448\u043A\u0443
        \u0446\u0435\u043B\u0443\u044E \u043D\u0435\u0434\u0435\u043B\u044E!"
    AudioClip:
      english: {fileID: 8300000, guid: 2d208724d65f9114aaa23c8f94300e6b, type: 3}
      russian: {fileID: 8300000, guid: 4e67b1e334095bf4e85065815efa0a3b, type: 3}
    SetAnimation: {fileID: 7400000, guid: 1881b62d8e484654ab32aaf091854abf, type: 2}
    PrefabPerson: {fileID: 2446768319233452451, guid: 73b4fe83063430e45b3c4a8875be9099, type: 3}
  - IDDialog: 1
    Message:
      english: Thanks, I knew you wouldn't refuse. Take the tire iron. I think you'll
        need it.
      russian: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u044F \u0437\u043D\u0430\u043B,
        \u0447\u0442\u043E \u0442\u044B \u043D\u0435 \u043E\u0442\u043A\u0430\u0436\u0435\u0448\u044C\u0441\u044F.
        \u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0443.
        \u0414\u0443\u043C\u0430\u044E, \u043E\u043D\u0430 \u0442\u0435\u0431\u0435
        \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F."
    AudioClip:
      english: {fileID: 8300000, guid: 925dff66763cb6441ab98810495642e3, type: 3}
      russian: {fileID: 8300000, guid: 3a54f1d491d0595479617a395970b7e4, type: 3}
    SetAnimation: {fileID: 7400000, guid: 543ddda5c0452e14cbc0f84dc46b8377, type: 2}
    PrefabPerson: {fileID: 2446768319233452451, guid: 73b4fe83063430e45b3c4a8875be9099, type: 3}
